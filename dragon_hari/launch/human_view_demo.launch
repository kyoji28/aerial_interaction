<?xml version="1.0"?>
<launch>
  <!-- ===== DRAGON simulation settings ===== -->
  <arg name="launch_dragon" default="true"/>
  <arg name="simulation" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty.world"/>

  <arg name="robot_spawn_x" default="0.0"/>
  <arg name="robot_spawn_y" default="0.0"/>
  <arg name="robot_spawn_z" default="0.0"/>
  <arg name="robot_spawn_yaw" default="0.0"/>

  <!-- ===== Human viewpoint model settings ===== -->
  <arg name="spawn_human" default="true"/>
  <arg name="show_image" default="true"/>

  <!-- Human stands at x=-2.0 and faces +X direction, toward DRAGON at origin -->
  <arg name="human_spawn_x" default="-2.0"/>
  <arg name="human_spawn_y" default="0.0"/>
  <arg name="human_spawn_z" default="0.0"/>
  <arg name="human_spawn_yaw" default="0.0"/>

  <!-- ===== Bring up DRAGON in Gazebo ===== -->
  <include file="$(find dragon)/launch/bringup.launch" if="$(arg launch_dragon)">
    <arg name="rm" value="False"/>
    <arg name="sim" value="$(arg simulation)"/>
    <arg name="real_machine" value="False"/>
    <arg name="simulation" value="$(arg simulation)"/>
    <arg name="launch_gazebo" value="True"/>
    <arg name="mujoco" value="False"/>
    <arg name="demo" value="False"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="worldtype" value="$(arg worldtype)"/>
    <arg name="spawn_x" value="$(arg robot_spawn_x)"/>
    <arg name="spawn_y" value="$(arg robot_spawn_y)"/>
    <arg name="spawn_z" value="$(arg robot_spawn_z)"/>
    <arg name="spawn_yaw" value="$(arg robot_spawn_yaw)"/>
  </include>

  <!-- ===== Spawn simple human viewpoint model ===== -->
  <node name="human_view_model_spawner"
        pkg="gazebo_ros"
        type="spawn_model"
        respawn="false"
        output="screen"
        if="$(arg spawn_human)"
        args="-file $(find dragon_hari)/urdf/human_view_model.urdf.xacro
              -urdf
              -model human_view_model
              -x $(arg human_spawn_x)
              -y $(arg human_spawn_y)
              -z $(arg human_spawn_z)
              -Y $(arg human_spawn_yaw)" />

  <!-- ===== Show first-person camera image ===== -->
  <node pkg="image_view"
        type="image_view"
        name="eye_image_view"
        args="image:=/eye/image_raw"
        if="$(arg show_image)" />
</launch>
